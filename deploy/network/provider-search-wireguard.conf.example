# Install on Provider Search as /etc/wireguard/wg-cms.conf, owned by root:root with mode 0600.
# Replace placeholders on the host. Never commit either private key.
[Interface]
Address = 10.77.0.2/30
PrivateKey = REPLACE_WITH_PROVIDER_SEARCH_PRIVATE_KEY

[Peer]
PublicKey = REPLACE_WITH_CMS_PUBLIC_KEY
Endpoint = 5.78.148.70:51820
AllowedIPs = 10.77.0.1/32
PersistentKeepalive = 25
